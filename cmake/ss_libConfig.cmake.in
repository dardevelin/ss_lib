# CMake package configuration for SS_Lib @PROJECT_VERSION@
# The imported target ss_lib::ss_lib carries the feature definitions the
# library was built with, so consumers always agree with it.
include(CMakeFindDependencyMacro)
if(@SS_ENABLE_THREAD_SAFETY@)
    find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/ss_libTargets.cmake")
