# find_package(ss_lib) version check for SS_Lib @PROJECT_VERSION@, written by
# `make install` (the CMake build generates its own). Semver: compatible with
# a request for the same major version that is not newer than this one.
set(PACKAGE_VERSION "@PROJECT_VERSION@")
set(PACKAGE_VERSION_COMPATIBLE FALSE)
if(PACKAGE_FIND_VERSION STREQUAL "")
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
elseif(PACKAGE_FIND_VERSION_MAJOR STREQUAL "@PROJECT_VERSION_MAJOR@"
       AND NOT PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_VERSION VERSION_EQUAL PACKAGE_FIND_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()

# A version range (min...max, CMake 3.19+) must also include this version
if(PACKAGE_VERSION_COMPATIBLE AND PACKAGE_FIND_VERSION_RANGE)
    if(PACKAGE_FIND_VERSION_RANGE_MAX STREQUAL "INCLUDE")
        if(PACKAGE_VERSION VERSION_GREATER PACKAGE_FIND_VERSION_MAX)
            set(PACKAGE_VERSION_COMPATIBLE FALSE)
        endif()
    elseif(NOT PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION_MAX)
        set(PACKAGE_VERSION_COMPATIBLE FALSE)
    endif()
endif()
