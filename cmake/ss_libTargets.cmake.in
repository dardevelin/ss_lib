# Imported target ss_lib::ss_lib for SS_Lib @PROJECT_VERSION@, written by
# `make install` (the CMake build generates its own with install(EXPORT)).
# Like ss_lib.pc it links the shared library and carries the feature
# definitions the library was built with.
if(TARGET ss_lib::ss_lib)
    return()
endif()
get_filename_component(_ss_lib_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
add_library(ss_lib::ss_lib SHARED IMPORTED)
set_target_properties(ss_lib::ss_lib PROPERTIES
    IMPORTED_LOCATION "${_ss_lib_prefix}/lib/@SHARED_REAL@"
    INTERFACE_INCLUDE_DIRECTORIES "${_ss_lib_prefix}/include/ss_lib;${_ss_lib_prefix}/include"
    INTERFACE_COMPILE_DEFINITIONS "@SS_FEATURE_DEFINITIONS@"
    INTERFACE_LINK_LIBRARIES "Threads::Threads")
unset(_ss_lib_prefix)
